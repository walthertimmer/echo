    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/echoincluded/.venv/bin/python",
            "cwd": "${workspaceFolder}/echoincluded",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload"
            ],
            "jinja": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/echoincluded"
            }
        }
    ]
}